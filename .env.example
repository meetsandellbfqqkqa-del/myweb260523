# Live AI model for the Vercel Serverless portfolio agent.
# Create a key in Google AI Studio and set it in Vercel Project Settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Local Qwen3 model served by Ollama.
# Used as a local development fallback; not used by GitHub Pages.
# Install Ollama, then run: ollama pull qwen3:8b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
